# LLM API Keys (Optional - System defaults to smart deterministic fallback if missing)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# System Hyperparameters
LLM_PROVIDER=openai # openai | gemini | mock
EMBEDDING_PROVIDER=openai # openai | gemini | mock

# Memory Settings
STM_MAX_TURNS=6
LTM_TOP_K=3

# RAG Settings
RAG_TOP_K=4
RRF_K=60
CRAG_THRESHOLD=6.0
