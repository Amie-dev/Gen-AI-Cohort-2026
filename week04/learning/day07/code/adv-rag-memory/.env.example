# LLM & Embedding Credentials
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# System Settings
PORT=8000
LLM_PROVIDER=openai # openai | gemini | vllm | mock
EMBEDDING_PROVIDER=openai # openai | gemini | mock

# Memory Settings (Mem0 + STM)
MEM0_TOP_K=3
STM_MAX_TURNS=6

# RAG Settings
RAG_TOP_K=5
RRF_K=60
CRAG_THRESHOLD=6.0
